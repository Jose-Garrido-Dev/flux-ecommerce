# Variables de la RAÍZ: solo las usa compose.prod.yml (producción).
# El backend tiene su propio backend/.env y el storefront lee las suyas desde aquí en producción.

# Versión que se etiqueta en las imágenes Docker (p. ej. 0.1.0)
FLUX_VERSION=latest

# Puertos internos (Nginx/Caddy del servidor hace de proxy hacia ellos)
BACKEND_PORT=8000
STOREFRONT_PORT=3000

# Base de datos PostgreSQL (deben coincidir con backend/.env)
DB_DATABASE=flux
DB_USERNAME=flux
DB_PASSWORD=CAMBIAR_POR_CLAVE_LARGA

# Meilisearch: solo si usas --profile search (opcional)
MEILISEARCH_KEY=

# Storefront
NEXT_PUBLIC_SITE_URL=https://www.mitienda.cl
# Secreto compartido para que Laravel pida revalidar páginas a Next.js (igual en backend/.env)
REVALIDATE_SECRET=CAMBIAR_POR_CLAVE_LARGA
