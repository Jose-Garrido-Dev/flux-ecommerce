# Copiar a .env.local para desarrollo sin Docker
# URL del backend Laravel vista desde el servidor de Next.js (nunca llega al navegador)
FLUX_API_INTERNAL_URL=http://localhost:8000
# URL pública de la tienda
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Igual a FLUX_REVALIDATE_SECRET del backend
REVALIDATE_SECRET=cambiar-en-cada-instalacion
