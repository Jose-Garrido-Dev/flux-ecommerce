# Plantilla de PRODUCCIÓN. Copiar a backend/.env y completar todo lo marcado CAMBIAR.
# Ver docs/INSTALACION.md, sección 5.
APP_NAME="Mi Tienda"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.mitienda.cl
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=flux
DB_USERNAME=flux
DB_PASSWORD=CAMBIAR_IGUAL_QUE_EN_.env_RAIZ
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.mitienda.cl

BROADCAST_CONNECTION=log
# Archivos en el disco del servidor (storage/). S3/R2 es opcional.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis es OPCIONAL (ver docs/INSTALACION.md, sección 8.2). Por defecto colas, caché y sesiones usan la base de datos.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.proveedor.com
MAIL_PORT=587
MAIL_USERNAME=CAMBIAR
MAIL_PASSWORD=CAMBIAR
MAIL_FROM_ADDRESS="ventas@mitienda.cl"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Flux ---
FLUX_STOREFRONT_URL=https://www.mitienda.cl
FLUX_REVALIDATE_SECRET=CAMBIAR_IGUAL_QUE_REVALIDATE_SECRET
FLUX_DISPLAY_TIMEZONE=America/Santiago
FLUX_STOREFRONT_RATE_LIMIT=120

# --- Búsqueda ---
# 'database' (por defecto) no requiere nada extra. Meilisearch es opcional: ver docs/INSTALACION.md, sección 8.2
SCOUT_DRIVER=database
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=
SANCTUM_STATEFUL_DOMAINS=www.mitienda.cl,mitienda.cl
